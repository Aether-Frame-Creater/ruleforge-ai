# ---------------------------------------------------------------------------
# RuleForge AI — example environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Neon PostgreSQL (pgvector enabled). Use the *pooled* connection string.
# https://console.neon.tech -> Project -> Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/ruleforge?sslmode=require"

# Direct (non-pooled) connection — used by `drizzle-kit` for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/ruleforge?sslmode=require"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL of the app (used by the auth client in the browser).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gen AI / Gemini API key from Google AI Studio.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# Main reasoning model used by the agents.
GEMINI_MODEL="gemini-3.5-flash"

# Cheap model for high-volume, low-stakes calls (chunk triage, labelling).
GEMINI_MODEL_LITE="gemini-3.5-flash-lite"

# Optional stand-in used when GEMINI_MODEL's request quota is exhausted.
# Leave empty to make a quota failure stop the run instead.
GEMINI_MODEL_FALLBACK="gemini-3.5-flash-lite"

# live | record | replay  (default: record)
#   live   - always calls the API, never reads the cache
#   record - calls the API and saves responses to storage/llm-cache
#   replay - serves saved responses only; never calls the API
LLM_MODE="record"

# Password for the demo users created by `npm run db:seed`
# (officer@/head@/ops@/auditor@ruleforge.demo). Minimum 8 characters.
DEMO_PASSWORD=""
