{
  "name": "ruleforge-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:guards": "node scripts/run-sql.mjs src/db/sql/guards.sql",
    "db:sync": "npm run db:push && npm run db:guards",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "check:rules": "tsx --env-file=.env.local scripts/check-rules.ts",
    "auth:generate": "npx @better-auth/cli@latest generate --config src/lib/auth/index.ts --output src/db/auth-schema.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@google/adk": "^2.3.0",
    "@google/genai": "^2.31.0",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "json-logic-js": "^2.0.5",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
