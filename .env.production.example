# ---------------------------------------------------------------------------
# RuleForge AI — Vercel environment variables
#
# Set these in the Vercel dashboard (Project -> Settings -> Environment
# Variables), not in a file. This example documents what each one is and where
# it comes from.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Neon POOLED connection string. The app runs on serverless functions, which
# open and drop connections constantly, so it must go through the pooler.
# Neon console -> Project -> Connection Details -> "Pooled connection".
# The host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/ruleforge?sslmode=require"

# Neon DIRECT (unpooled) connection string. Used by migrations and the
# deployment scripts only — the pooler does not support every DDL statement.
# Same page, "Direct connection". The host has no "-pooler".
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/ruleforge?sslmode=require"

# --- Auth ------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The deployment's own URL, with https. Cookies are issued for this origin, so
# it must match exactly or sign-in will appear to succeed and then fail.
# Production: https://your-project.vercel.app (or your custom domain)
BETTER_AUTH_URL="https://your-project.vercel.app"

# The same URL again, exposed to the browser for the auth client.
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# --- Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_MODEL_LITE="gemini-3.5-flash-lite"
GEMINI_MODEL_FALLBACK="gemini-3.5-flash-lite"

# cache | live | record | replay
# Use "replay" for a demo environment with an imported cache: it never calls
# the API, so a quota cannot break the demo.
LLM_MODE="cache"

# --- Storage ---------------------------------------------------------------
# Vercel's filesystem is read-only at runtime, so uploads must go to Blob.
STORAGE_DRIVER="blob"

# Injected automatically when a Blob store is linked to the project
# (Vercel dashboard -> Storage -> Create -> Blob -> Connect Project).
# Only set it by hand when running against Blob from a local machine.
BLOB_READ_WRITE_TOKEN=""

# --- Serverless limits -----------------------------------------------------
# Seconds one pipeline invocation may use before it stops at a stage boundary
# and reports "incomplete" for the client to continue. Keep it below the
# function's maxDuration (60 on Hobby) with headroom for the final writes.
PIPELINE_MAX_SECONDS="55"

# --- Demo ------------------------------------------------------------------
# Password for the four seeded demo users. Needed only to run db:seed.
DEMO_PASSWORD=""

# Shows one-click role switching on the login page. Acceptable for a pitch
# environment; never for anything with real data.
DEMO_MODE="false"
